# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_BOOTSTRAP_SECRET: Required on the server to unlock initial Super Admin setup.
ADMIN_BOOTSTRAP_SECRET="CHANGE_ME_SECURE_BOOTSTRAP_SECRET"

# ADMIN_OWNER_EMAIL: Verified owner email eligible for initial Super Administrator provisioning.
ADMIN_OWNER_EMAIL="mimoto3939@gmail.com"
